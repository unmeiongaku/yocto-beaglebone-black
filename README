Makefile

.PHONY:copy diff add  clear

copy:
    cp ./poky/build-bbb/tmp/work-shared/beaglebone/kernel-source/arch/arm/boot/dts/ti/omap/am335x-boneblack.dts ./

    cp am335x-boneblack.dts am335x-boneblack.dts.orig
    
    ////Edit your dts///

diff:
	-git diff --no-index am335x-boneblack.dts.orig am335x-boneblack.dts > 0001-add-dev-dts.patch
	cat 0001-add-dev-dts.patch
add:
	cp 0001-add-dev-dts.patch ./poky/meta-bbb/recipes-core/linux/files
clear:
	rm -rf 0001-add-dev-dts.patch
